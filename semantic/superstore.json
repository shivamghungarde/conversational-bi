      ]
    },
    {
      "name": "return_reason",
      "label": "Return reason",
      "plural": "return reasons",
      "sql": "COALESCE(r.return_reason, 'Not returned')",
      "join": "returns",
      "synonyms": [
        "return reason",
        "return reasons",
        "reason for return",
        "reasons for return"
      ]
    },
    {
      "name": "return_status",
      "label": "Return status",
      "plural": "return statuses",
      "sql": "CASE WHEN r.order_id IS NULL THEN 'Kept' ELSE 'Returned' END",
      "join": "returns",
      "synonyms": [
        "return status",
        "returned or kept",
        "returned or not"
      ]
    }
  ],
  "sample_queries": [
